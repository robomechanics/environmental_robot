<?xml version="1.0"?>
<launch>
    <arg name="useGPS" default="true"/>

    <!-- load rosparams for services and topics -->
    <rosparam command="load" file="$(find autonomy_manager)/config/constants.yaml" />

    <!-- Static TF: base_link -> gq7_link -->
    <node pkg="tf2_ros" type="static_transform_publisher" name="base_to_gq7_link"
            args="0.015 0.0065 0 0 0 0 1 base_link gq7_link" />

    <!-- GPS Localization -->
    <group if="$(arg useGPS)">
        <include file = "$(find robo_nav)/launch/gq7_odom_hebi.launch"/>

        <!-- Start GPS Interface -->
        <node name="gps_navigation_interface" pkg="robo_nav" type="gps_navigation_interface.py" output="screen" />
    </group >

    <!-- <node pkg="rosbag" name="record" type="record" args="-a -O gps_test.bag" /> -->
</launch>
